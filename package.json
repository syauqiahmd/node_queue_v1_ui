{
  "name": "queue-management-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "oxlint --fix -D correctness",
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.12.1",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "flatpickr": "^4.6.13",
    "lucide-vue-next": "^0.474.0",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.22.3",
    "vue": "^3.5.13",
    "vue-flatpickr-component": "^11.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "postcss": "^8.5.1",
    "prettier": "3.5.3",
    "sass-embedded": "^1.83.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
