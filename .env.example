# ─────────────────────────────────────────────
# API & WebSocket
# ─────────────────────────────────────────────

# Base URL of the backend API.
# Development (via Vite proxy):  /api
# Local backend directly:        http://localhost:8000/api
# Remote server:                 https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Explicit WebSocket URL.
# If omitted, the app will derive it automatically from VITE_API_BASE_URL.
# Use this when the WebSocket server runs on a different host or port.
# Development: ws://localhost:8080
# Remote:      wss://ws.yourdomain.com
# VITE_WS_URL=ws://localhost:8080

# WebSocket base URL (alternative to VITE_WS_URL).
# Used as a fallback if VITE_WS_URL is not set.
# VITE_SOCKET_BASE_URL=ws://localhost:8080

# ─────────────────────────────────────────────
# Timezone
# ─────────────────────────────────────────────

# IANA timezone name used for date/time display on /monitor and /ticket pages,
# and for the timestamp printed on thermal ticket receipts.
# WIB  → Asia/Jakarta   (UTC+7)
# WITA → Asia/Makassar  (UTC+8)
# WIT  → Asia/Jayapura  (UTC+9)
VITE_TIMEZONE=Asia/Makassar

# ─────────────────────────────────────────────
# /monitor page
# ─────────────────────────────────────────────

# Title displayed at the top of the monitor screen.
VITE_MONITOR_TITLE=Nama Instansi Anda

# Show the service name below the loket badge when a ticket is called.
# Set to "true" to enable, omit or set to anything else to disable.
# VITE_MONITOR_SHOW_SERVICE=true

# ─────────────────────────────────────────────
# /ticket page (kiosk)
# ─────────────────────────────────────────────

# Show the service name (svc.name) on each service card.
# Useful when one organization has multiple services.
# Set to "true" to enable, omit or set to anything else to disable.
# VITE_TICKET_SHOW_SERVICE_NAME=true

# Ask the visitor to fill in their name, phone number, and (optional) email
# in a modal before a ticket is created. When disabled, tickets are created
# immediately on service selection like before.
# Set to "true" to enable, omit or set to anything else to disable.
# VITE_REQUIRE_VISITOR_DATA=true

# ─────────────────────────────────────────────
# Audio proxy (/monitor)
# ─────────────────────────────────────────────

# Proxy path for audio files stored on is3.cloudhost.id.
# Only needed in production when the Vite dev proxy (/audio) is unavailable.
# Example: if your Nginx proxies /audio → https://is3.cloudhost.id
# VITE_AUDIO_PROXY_PATH=/audio

# ─────────────────────────────────────────────
# Thermal printer — Recta (/ticket)
# ─────────────────────────────────────────────

# Recta printer device ID. Provided by your Recta account/device setup.
# VITE_RECTA_PRINTER_ID=1234567890

# Recta printer profile ID. Defines the receipt layout template.
# VITE_RECTA_PROFILE=1811
